{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "0. Mo giao dien (trinh duyet)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\GiaoDien.ps1"
      ],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "1. So sanh cau hinh (nhanh)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\Chay.ps1",
        "-Viec",
        "sosanh",
        "-Nhom",
        "${input:nhom}"
      ],
      "problemMatcher": []
    },
    {
      "label": "2. Cap nhat bot vao MT5",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\Chay.ps1",
        "-Viec",
        "capnhat"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "3. So sanh cau hinh (chinh xac, cham)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\Chay.ps1",
        "-Viec",
        "sosanh-chinhxac"
      ],
      "problemMatcher": []
    },
    {
      "label": "Bot: tu cap nhat khi mo VS Code",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\Chay.ps1",
        "-Viec",
        "theodoi"
      ],
      "problemMatcher": [],
      "isBackground": true,
      "hide": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Bot: backtest 1 lan",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\Chay.ps1",
        "-Viec",
        "backtest"
      ],
      "problemMatcher": [],
      "hide": true
    }
  ],
  "inputs": [
    {
      "id": "nhom",
      "type": "pickString",
      "description": "Chay nhom cau hinh nao?",
      "options": [
        {
          "label": "Theo chi-chay.txt (Claude chon)",
          "value": "file"
        },
        {
          "label": "H4 va cac bo loc",
          "value": "h4"
        },
        {
          "label": "Luot song (von 30.000)",
          "value": "luotsong"
        },
        {
          "label": "Luot song voi von 1 trieu VND",
          "value": "von1tr"
        },
        {
          "label": "Chay het (lau)",
          "value": "tatca"
        }
      ],
      "default": "file"
    }
  ]
}